  "master_ref": "upstream/master",
  "default_decisions": {
    "same_as_stable": "aligned_with_stable",
    "different_from_stable": "inherit_with_pr6_baseline",
    "fork_only": "fork_specific_review",
    "stable_only": "inherit_with_pr6_baseline",
    "master_only_or_changed": "observe_master"
  },
  "overrides": {
    "cargo:cxx": {
      "decision": "security_update_after_pr6_baseline",
      "reason": "RUSTSEC-2026-0202 is fixed in 1.0.195. The current topjohnwu cxx fork carries a six-file patch on 1.0.189 and its configured remote does not yet publish a compatible fixed pin. Do not create an unreachable gitlink: forward-port the patch only after pristine PR6 builds, then require all-ABI link, boot sign/verify, parser corpus, and AVD gates."
    },
    "cargo:rand": {
      "decision": "retire_with_current_core",
      "reason": "RUSTSEC-2026-0097 is fixed in 0.8.6, but rand is transitive through the old RSA stack and is absent from v30.7. Its triggering logger/thread_rng combination is not enabled here. Avoid modernizing the old core twice."
    },
    "cargo:rsa": {
      "decision": "open_risk_no_false_ignore",
      "reason": "RUSTSEC-2023-0071 has no patched release. Kitsune uses private-key signing only in the local magiskboot process, not as a network signing oracle. Keep the advisory visible and rerun boot sign/verify whenever the crypto stack changes."
    },
    "cargo:ansi_term": {
      "decision": "inherit_with_pr6_baseline",
      "reason": "Build-time protobuf tooling dependency on the old core; absent after the stable baseline tooling migration."
    },
    "cargo:atty": {
      "decision": "inherit_with_pr6_baseline",
      "reason": "Build-time protobuf tooling dependency on the old core. The reported unaligned read is Windows-only; PR6 removes this chain."
    }
  },
