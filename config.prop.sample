##########################################################
# Debug builds need no local config. Release builds require all four signing
# values in the ignored `config.prop` or in a file selected with `-c`.
# Back up the production keystore securely and never commit it.
##########################################################

# The version name of Magisk. It must contain the lowercase marker `kitsune`
# used by compatible external integrations. Default: <git HEAD short SHA1>-kitsune
version=string

# Output path. Default: out
outdir=string

#####################################################
# Signing configs for signing zips and APKs
# Release builds require all four variables. Never commit real values.
#####################################################

# Path to the keystore (relative to the repository root or absolute)
keyStore=string
# Keystore password
keyStorePass=string
# The desired key alias in the keystore
keyAlias=string
# Password of specified key alias
keyPass=string
