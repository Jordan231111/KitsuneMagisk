{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jordan231111/KitsuneMagisk/schemas/system-mode/adapter-v1.schema.json",
  "title": "Kitsune System Mode adapter descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "tier", "execution", "capabilities", "requires_stopped_target"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "tier": {"enum": ["A", "B", "C", "D"]},
    "execution": {"enum": ["in_guest", "host_image", "recovery", "reject"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "requires_stopped_target": {"type": "boolean"}
  }
}
